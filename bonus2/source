/* main */
int main(int argc, char **argv)
{
    char buf[76];                         /* esp+0x50, pré-rempli de zéros */

    if (argc != 3) return 1;

    strncpy(buf,      argv[1], 40);        /* argv[1] -> buf[0..39]  */
    strncpy(buf + 40, argv[2], 32);        /* argv[2] -> buf[40..71] */

    char *lang = getenv("LANG");
    if (lang) {
        if (memcmp(lang, "fi", 2) == 0) language = 1;
        else if (memcmp(lang, "nl", 2) == 0) language = 2;
    }                                      /* sinon language = 0 (en) */

    memcpy(esp, buf, 76);                  /* recopie le nom au sommet de pile */
    greetuser();                           /* la faille est ici */
}

/* greetuser */
void greetuser(void)                       /* ebp+8 = nom de 72 octets */
{
    char local[72];                        /* ebp-0x48 */

    switch (language) {
        case 0: memcpy(local, "Hello ",        7);  break;  /* strlen 6  */
        case 1: memcpy(local, "Hyvää päivää ", 19); break;  /* strlen 18 */
        case 2: memcpy(local, "Goedemiddag! ", 14); break;  /* strlen 13 */
    }
    strcat(local, name);                   /* préfixe + 72 octets -> DÉBORDEMENT */
    puts(local);
}